{
  "manifest_version": 3,
  "name": "TU Zeiterfassung – Monat ausfüllen",
  "version": "1.1.1",
  "description": "Trägt in „My Time Tracking“ der TU Berlin für alle Arbeitstage eines Monats Kommen- und Gehen-Zeiten ein.",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://*.sap.tu-berlin.de/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TU Zeiterfassung",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
